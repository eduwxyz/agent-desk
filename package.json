{
  "name": "agent-desk",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop chat where you work with a team of AI agents, with scopes, approvals and budgets.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node --test e2e/",
    "dist": "npm run build && electron-builder --mac --dir --config.directories.output=\"$HOME/Library/Caches/agent-desk/dist\"",
    "install-app": "npm run dist && sh scripts/install-app.sh",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "smol-toml": "^1.9.1"
  },
  "build": {
    "appId": "dev.agentdesk.app",
    "productName": "agent-desk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "6C1136FF905F090E59F074F828586E158AE31DB3",
      "hardenedRuntime": false
    }
  }
}
